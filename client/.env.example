# Optional: call the API directly (bypasses Vite proxy). Requires CORS on the API.
# VITE_API_URL=http://localhost:5133

# VITE_INCIDENTS_API_URL=http://localhost:5134
# Incidents API base URL. Defaults to http://localhost:5134 if unset.
# IncidentsApi allows CORS from http://localhost:5173 so no Vite proxy needed.

# VITE_AUDITS_API_URL=http://localhost:5135
# Audits API base URL. Defaults to http://localhost:5135 if unset.
# AuditsApi allows CORS from http://localhost:5173 so no Vite proxy needed.
