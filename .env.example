# Unix/Git Bash:  cp .env.example .env
# PowerShell:     Copy-Item .env.example .env
#
# API key from console.anthropic.com — sends the PR diff to the Anthropic Messages API for
# automated review. Create at Settings → API Keys; copy to `.env` and never commit the real key.
ANTHROPIC_API_KEY=your-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6  # optional — overrides the default model

# Fine-grained personal access token scoped to this repository only, with pull_requests: write
# and contents: read — fetches the PR diff and posts the review comment. Prefer this over a
# broad repo-scoped classic PAT. `gh auth token` is convenient for local testing only, not
# for production use.
GITHUB_TOKEN=your-github-token-here

PR_NUMBER=42  # replace with the actual open PR number before running locally

# Repository in owner/repo format (e.g. jamie/radar-practice) — same shape as GitHub Actions' GITHUB_REPOSITORY
GITHUB_REPOSITORY=owner/repo

# Nightly agent settings — only needed when running nightly-agent.js locally
# TASK_MODE=easy          # easy | medium | hard — defaults to easy if not set
# TASK_CATEGORY=          # optional — filters by category (a11y, code-quality, docs, pr-review, infra)
# GITHUB_ACTIONS=true     # set to true to enable full autonomous mode locally (normally set by Actions)

# ASP.NET Core API overrides — each API reads its own appsettings.json by default.
# dotnet does not load this .env file automatically; export these in your shell
# before `dotnet run`, or set them in launchSettings / CI.
#
# ConnectionStrings__DefaultConnection=DataSource=app.db          # ItemsApi
# ConnectionStrings__DefaultConnection=DataSource=incidents.db      # IncidentsApi
# ConnectionStrings__DefaultConnection=DataSource=audits.db       # AuditsApi
#
# Cors__AllowedOrigins__0=http://localhost:5173
# Cors__AllowedOrigins__1=https://localhost:5173
