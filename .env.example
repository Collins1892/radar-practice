ANTHROPIC_API_KEY=your-api-key-here

# Personal access token with repo scope (or run `gh auth token` after `gh auth login`) — fetches the PR diff and posts the review comment
GITHUB_TOKEN=your-github-token-here

# Pull request number to review — from the PR URL (e.g. github.com/owner/repo/pull/42 → 42)
PR_NUMBER=1

# Repository in owner/repo format (e.g. jamie/radar-practice) — same shape as GitHub Actions' GITHUB_REPOSITORY
GITHUB_REPOSITORY=owner/repo
